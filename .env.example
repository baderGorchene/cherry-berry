DATABASE_URL=postgres://cherry:cherry@localhost:5432/cherry
# Tests default to in-memory PGlite; set to a real Postgres to test against it.
# TEST_DATABASE_URL=postgres://cherry:cherry@localhost:5432/cherry_test
# Required. Generate one: openssl rand -base64 32  (the server refuses values starting with "change-me")
AUTH_SECRET=change-me
# Behind nginx/Caddy/Traefik: "true", a hop count (1) or trusted proxy CIDRs. Leave unset when exposed directly.
# TRUST_PROXY=1
# LOG_LEVEL=info
PUBLIC_URL=http://localhost:5173
PORT=3000
# Comma-separated emails of instance admins. Editing this is the recovery path if an admin is locked out.
# Create the admin account first: whoever first signs up with a listed email becomes instance admin, under any
# registration policy. The server logs a warning for each listed email with no account yet.
# ADMIN_EMAILS=you@example.com
# Optional print service (apps/print) for PDF/X and colour-plate exports.
# PRINT_URL=http://localhost:8080
# Serve the built web app from this server (production). A relative path resolves against the process working directory.
# WEB_DIST=apps/web/dist
# Object storage (S3-compatible). Use "memory:" for throwaway in-process storage; bucket and keys are then unused.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=cherry
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# S3_REGION=us-east-1
