{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cherry Berry",
  "version": "0.1.0",
  "identifier": "org.cherryberry.studio",
  "build": {
    "frontendDist": "../../launcher/dist",
    "beforeDevCommand": "pnpm --filter @cherry/launcher build",
    "beforeBuildCommand": "pnpm --filter @cherry/launcher build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Cherry Berry",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "create": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
